# ── Database (Neon) ─────────────────────────────────────────────
# Neon dashboard → your project → "Connect" → UNCHECK "Connection pooling"
# and copy the direct connection string:
#   postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL=""

# ── Auth.js (Phase 5) ───────────────────────────────────────────
# AUTH_SECRET=            # npx auth secret
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# ── Cloudinary (Phase 6) ────────────────────────────────────────
# CLOUDINARY_CLOUD_NAME=            # server: signing uploads
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=  # client: building delivery URLs (same value)

# ── Resend (Phase 4/8) ──────────────────────────────────────────
# RESEND_API_KEY=
