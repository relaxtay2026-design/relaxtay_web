// Prisma schema — Direct Property Booking Platform
// See IMPLEMENTATION_PRD.md §4 (data model) and §5 (booking engine).
//
// Conventions:
// - Money is integer cents, always paired with an ISO-4217 currency code (D3).
// - Emails are normalized to lowercase at every write site (no citext).
// - Booking dates are half-open: [checkIn, checkOut) — checkout day is free.
// - The booking_no_overlap exclusion constraint lives in a raw SQL migration;
//   Prisma cannot express it. NEVER edit that migration away.

generator client {
  provider = "prisma-client-js"
}

// Connection URLs live in prisma.config.ts (Prisma 7 convention):
// DATABASE_URL (pooled) for queries, DIRECT_URL (unpooled) for migrations.
datasource db {
  provider = "postgresql"
}

// ─── Auth (Auth.js v5 adapter models + our user extensions) ──────────────

enum Role {
  guest
  manager
}

enum AccountStatus {
  unclaimed // customer exists via a booking, hasn't claimed the account (PRD §26)
  active
  disabled
}

model User {
  id               String        @id @default(cuid())
  name             String
  email            String        @unique // ALWAYS stored lowercase
  emailVerified    DateTime?
  image            String?
  phone            String?
  role             Role          @default(guest)
  accountStatus    AccountStatus @default(unclaimed)
  marketingOptIn   Boolean       @default(false)
  marketingOptInAt DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  accounts Account[]
  sessions Session[]
  bookings Booking[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String // 'google' | 'credentials'
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  passwordHash      String? // credentials provider only (PRD §49 split-credentials model)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Also carries account-claim and password-reset tokens (single-use, hashed).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  purpose    String   @default("verify") // 'verify' | 'claim' | 'reset'

  @@unique([identifier, token])
}

// ─── Properties ──────────────────────────────────────────────────────────

enum PropertyStatus {
  active
  inactive // archived: hidden publicly, keeps bookings/reviews (PRD §40)
}

model Property {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  summary     String // short intro line for cards
  description String // long-form editorial copy
  location    String // display string, e.g. "Whistler, British Columbia"
  priceCents  Int // nightly rate in cents
  currency    String         @default("USD") // ISO-4217, display-only, no conversion (D3)
  maxGuests   Int
  bedrooms    Int
  beds        Int
  bathrooms   Int
  minNights   Int            @default(1)
  status      PropertyStatus @default(active)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  images    PropertyImage[]
  amenities PropertyAmenity[]
  bookings  Booking[]
  blocks    AvailabilityBlock[]
  reviews   Review[]
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  // Cloudinary public ID in production; seed data may hold a full https URL —
  // the image helper treats anything starting with http(s) as a literal URL.
  src        String
  alt        String
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
}

model Amenity {
  id        String @id @default(cuid())
  name      String @unique
  icon      String // lucide icon name
  sortOrder Int    @default(0)

  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
}

// ─── Bookings (the heart) ────────────────────────────────────────────────

enum BookingStatus {
  pending // holds dates; awaiting manager decision (D2 request-to-book)
  confirmed // holds dates
  declined // never accepted — does NOT hold dates
  cancelled // was going to happen, then wasn't — does NOT hold dates
  completed // checkout passed while confirmed
}

model Booking {
  id     String @id @default(cuid())
  code   String @unique // human reference, e.g. LUM-10482
  userId String?

  propertyId String

  // Guest snapshot — kept even when userId is set, so history stays true (PRD §50)
  guestName    String
  guestEmail   String // lowercase
  guestPhone   String
  guestCount   Int
  guestMessage String?

  checkIn  DateTime @db.Date
  checkOut DateTime @db.Date

  // Price snapshot at booking time (never recomputed from Property)
  nightlyPriceCents Int
  totalCents        Int
  currency          String

  status                  BookingStatus @default(pending)
  statusNote              String? // manager-facing note on decline/cancel
  cancellationRequestedAt DateTime? // guest requested; manager executes (D7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  property Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId, checkIn, checkOut])
  @@index([guestEmail])
  @@index([status])
}

// Manager-created unavailability: maintenance, offline/other-channel bookings (D4).
// Same half-open convention: [startDate, endDate).
model AvailabilityBlock {
  id         String   @id @default(cuid())
  propertyId String
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  note       String?
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, startDate, endDate])
}

// ─── Reviews (manager-curated in V1, PRD §46) ────────────────────────────

model Review {
  id          String   @id @default(cuid())
  propertyId  String
  authorName  String
  rating      Int // 1..5 (checked in code + DB CHECK constraint)
  body        String
  stayedMonth String? // e.g. "August 2026"
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, isPublished])
}
